            },
            "grantId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "commandId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "inputDigest": {
