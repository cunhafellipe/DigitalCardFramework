{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/editor-transform/v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "kind",
        "requestId",
        "toolId",
        "toolVersion",
        "sourceDigest",
        "parameters",
        "grants"
      ],
      "properties": {
        "protocol": {
          "const": "digital-card-editor-transform@1"
        },
        "kind": {
          "const": "request"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "toolId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "toolVersion": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "faces",
            "newRasterAssets",
            "capabilities"
          ],
          "properties": {
            "faces": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "front",
                  "back"
                ]
              }
            },
            "newRasterAssets": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "kind",
        "requestId",
        "toolId",
        "toolVersion",
        "sourceDigest"
      ],
      "properties": {
        "protocol": {
          "const": "digital-card-editor-transform@1"
        },
        "kind": {
          "const": "result"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "toolId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9.-]+$"
        },
        "toolVersion": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  ]
}
