  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node examples/server.js",
    "production": "node --env-file=.env host/server.js",
    "contract": "node tools/generate-openapi.js && node tools/generate-wire-types.mjs && node tools/generate-wire-validators.mjs",
    "test:sdk": "node tools/check-sdk-types.mjs",
    "test:browser": "node test/presentation-audit-browser.mjs",
    "test:spec": "node docs/complex-cards/check-examples.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
