              "maximum": 9007199254740991
            },
            "commandId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "snapshotDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "deadline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "status": {
              "const": "error"
            },
            "errorCode": {
              "enum": [
                "invalid-request",
                "unauthenticated",
                "rate-limited",
                "unavailable"
              ]
            }
          },
          "required": [
            "protocol",
            "operation",
            "scope",
            "phase",
            "requestId",
            "providerId",
            "grantId",
            "generation",
            "commandId",
            "inputDigest",
            "snapshotDigest",
            "deadline",
            "status",
            "errorCode"
          ]
        }
      ]
    }
  }
}
