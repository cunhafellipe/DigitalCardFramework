{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/purchase-policy/v1",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "digital-card-purchase-policy@1"
        },
        "operation": {
          "const": "canPurchase"
        },
        "scope": {
          "const": "listing"
        },
        "phase": {
          "enum": [
            "quote",
            "purchase"
          ]
        },
        "requestId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
        },
        "grantId": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "commandId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "inputDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "snapshotDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
        },
        "deadline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
                }
              },
              "required": [
                "id"
              ]
            },
            "shop": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
                },
                "ownerId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
                },
                "kind": {
                  "enum": [
                    "admin",
                    "player"
                  ]
                }
              },
              "required": [
                "id",
                "ownerId",
                "kind"
              ]
            },
            "listing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
                },
                "kind": {
                  "enum": [
                    "mint-card",
                    "mint-pack",
                    "copies",
                    "packs",
                    "action"
                  ]
                },
                "price": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "currencyId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100,
                      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "currencyId",
                    "amount"
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "price"
              ]
            },
            "quantity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "unitIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
              }
            }
          },
          "required": [
            "user",
            "shop",
            "listing",
            "quantity",
            "unitIds"
          ]
        }
