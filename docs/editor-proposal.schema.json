{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/editor-proposal/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshotId",
    "revision",
    "patch"
  ],
  "properties": {
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f-]{36}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "patch": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "rotation": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "width": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 20000
        },
        "height": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 20000
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "brightness": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "typography.size": {
          "type": "number",
          "minimum": 1,
          "maximum": 1000
        },
        "typography.lineHeight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 5
        },
        "typography.letterSpacing": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "typography.align": {
          "enum": [
            "left",
            "center",
            "right",
            "start",
            "end"
          ]
        },
        "blend": {
          "enum": [
            "normal",
            "screen",
            "add",
            "multiply"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    }
  }
}
