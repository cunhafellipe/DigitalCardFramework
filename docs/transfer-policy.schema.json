                "accept",
                "list",
                "quote",
                "purchase"
              ]
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
            },
            "providerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
            },
            "grantId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "commandId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "inputDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "snapshotDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "deadline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "status": {
              "const": "allowed"
            }
          },
          "required": [
            "protocol",
            "operation",
            "scope",
            "phase",
            "requestId",
            "providerId",
            "grantId",
            "generation",
            "commandId",
            "inputDigest",
            "snapshotDigest",
            "deadline",
            "status"
          ]
        },
        {
