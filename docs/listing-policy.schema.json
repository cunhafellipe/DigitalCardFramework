                "restricted",
                "unavailable"
              ]
            }
          },
          "required": [
            "protocol",
            "operation",
            "scope",
            "phase",
            "requestId",
            "providerId",
            "grantId",
            "generation",
            "commandId",
            "inputDigest",
            "snapshotDigest",
            "deadline",
            "status",
            "reasonCode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "digital-card-listing-policy@1"
            },
            "operation": {
              "const": "canList"
            },
            "scope": {
              "const": "listing"
            },
            "phase": {
              "const": "create"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
            },
            "providerId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*(?![\\s\\S])"
            },
            "grantId": {
              "type": "string",
              "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}(?![\\s\\S])"
            },
            "generation": {
              "type": "integer",
