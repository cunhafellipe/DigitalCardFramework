{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-card.invalid/editor-contribution/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "id",
    "version",
    "title",
    "controls"
  ],
  "properties": {
    "protocol": {
      "const": "digital-card-editor-contribution@1"
    },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9.-]+(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "field",
          "minimum",
          "maximum",
          "step"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-z][a-z0-9.-]+(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "field": {
            "enum": [
              "x",
              "y",
              "rotation"
            ]
          },
          "minimum": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "maximum": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          }
        }
      }
    }
  }
}
