            },
            "snapshotDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
            },
            "deadline": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "status": {
              "const": "allowed"
            }
          },
          "required": [
            "protocol",
            "operation",
            "scope",
            "phase",
            "requestId",
            "providerId",
            "grantId",
            "generation",
            "commandId",
            "inputDigest",
