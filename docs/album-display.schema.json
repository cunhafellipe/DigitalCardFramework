{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "snapshotId",
    "fields",
    "pages",
    "items",
    "previews"
  ],
  "properties": {
    "profile": {
      "const": "dc.album-display@1"
    },
    "snapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "fields": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5,
      "items": {
        "enum": [
          "albumName",
          "cardName",
          "rarity",
          "pageName",
          "preview"
        ]
      }
    },
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "name": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "position",
          "page"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "position": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "name": {
            "type": "string",
            "maxLength": 100
          },
          "rarity": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    "previews": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "handle",
          "mediaType",
          "bytes"
        ],
        "properties": {
          "handle": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "mediaType": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp"
            ]
          },
          "bytes": {
            "description": "Native Uint8Array; validated separately from JSON Schema."
          }
        }
      }
    }
  }
}
